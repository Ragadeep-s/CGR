<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="CGR Fabrication — scaffolding, rental and custom fabrication solutions in Puducherry.">
  <title>CGR Fabrication | Scaffolding & Fabrication Solutions</title>

  <link rel="preconnect" href="https://api.fontshare.com">
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&f[]=boska@400,500,700&display=swap" rel="stylesheet">

  <style>
    :root {
      --text-xs: clamp(.75rem, .7rem + .25vw, .875rem);
      --text-sm: clamp(.875rem, .8rem + .35vw, 1rem);
      --text-base: clamp(1rem, .95rem + .25vw, 1.125rem);
      --text-lg: clamp(1.125rem, 1rem + .75vw, 1.5rem);
      --text-xl: clamp(1.5rem, 1.2rem + 1.25vw, 2.25rem);
      --text-2xl: clamp(2rem, 1.2rem + 2.5vw, 3.5rem);
      --text-3xl: clamp(2.5rem, 1rem + 4vw, 5rem);

      --space-1: .25rem;
      --space-2: .5rem;
      --space-3: .75rem;
      --space-4: 1rem;
      --space-5: 1.25rem;
      --space-6: 1.5rem;
      --space-8: 2rem;
      --space-10: 2.5rem;
      --space-12: 3rem;
      --space-16: 4rem;
      --space-20: 5rem;
      --space-24: 6rem;
      --space-32: 8rem;

      --radius-sm: .375rem;
      --radius-md: .5rem;
      --radius-lg: .75rem;
      --radius-xl: 1rem;
      --radius-full: 9999px;

      --font-body: "Satoshi", Arial, sans-serif;
      --font-display: "Boska", Georgia, serif;
      --content-wide: 1200px;
      --transition: 180ms cubic-bezier(.16, 1, .3, 1);
    }

    [data-theme="dark"] {
      --bg: #111417;
      --surface: #171b1e;
      --surface-2: #1c2226;
      --text: #f0f2ed;
      --muted: #aeb7b9;
      --faint: #778286;
      --line: rgba(240, 242, 237, .13);
      --gold: #f6aa1c;
      --gold-hover: #ffc454;
    }

    [data-theme="light"] {
      --bg: #f5f4f0;
      --surface: #ffffff;
      --surface-2: #f3f1ec;
      --text: #172126;
      --muted: #5d696d;
      --faint: #7e888a;
      --line: rgba(23, 33, 38, .13);
      --gold: #b86f00;
      --gold-hover: #8c5300;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 5rem;
    }

    body {
      min-height: 100dvh;
      font: var(--text-base)/1.6 var(--font-body);
      background: var(--bg);
      color: var(--text);
    }

    img {
      display: block;
      max-width: 100%;
      height: auto;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
      color: inherit;
      cursor: pointer;
      border: 0;
    }

    .container {
      width: min(calc(100% - 2rem), var(--content-wide));
      margin-inline: auto;
    }

    .eyebrow {
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: .14em;
      color: var(--gold);
      font-weight: 700;
    }

    .section {
      padding-block: clamp(var(--space-16), 8vw, var(--space-32));
    }

    .section-head {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-10);
      max-width: 760px;
    }

    .section h2 {
      font: 500 var(--text-2xl)/1.08 var(--font-display);
    }

    .section-copy {
      color: var(--muted);
      max-width: 60ch;
    }

    .topbar {
      font-size: var(--text-xs);
      border-bottom: 1px solid var(--line);
      color: var(--muted);
    }

    .topbar .container {
      min-height: 2.75rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-4);
    }

    .topbar-links {
      display: flex;
      gap: var(--space-5);
      flex-wrap: wrap;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 30;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--line);
    }

    .nav {
      min-height: 5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
    }

    .logo-placeholder {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      font-weight: 900;
      letter-spacing: .05em;
    }

    .logo-mark {
      width: 2.3rem;
      aspect-ratio: 1;
      border: 1px dashed var(--gold);
      display: grid;
      place-items: center;
      color: var(--gold);
      font-size: var(--text-xs);
    }

    .logo-text small {
      display: block;
      font-weight: 500;
      color: var(--muted);
      font-size: var(--text-xs);
      letter-spacing: .1em;
    }

    .nav-links {
      display: flex;
      gap: var(--space-6);
      align-items: center;
      font-size: var(--text-sm);
    }

    .nav-links a:hover {
      color: var(--gold);
    }

    .nav-actions {
      display: flex;
      gap: var(--space-3);
      align-items: center;
    }

    .theme,
    .menu {
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-full);
      background: transparent;
    }

    .btn {
      min-height: 2.9rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 var(--space-5);
      gap: var(--space-2);
      font-size: var(--text-sm);
      font-weight: 700;
      border-radius: var(--radius-sm);
      transition: transform var(--transition), background var(--transition);
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn-primary {
      background: var(--gold);
      color: #17120a;
    }

    .btn-primary:hover {
      background: var(--gold-hover);
    }

    .btn-secondary {
      border: 1px solid var(--line);
      background: transparent;
    }

    .btn-secondary:hover {
      background: var(--surface-2);
    }

    .menu {
      display: none;
    }

    .hero {
      position: relative;
      min-height: calc(100dvh - 7.75rem);
      display: grid;
      align-items: end;
      overflow: hidden;
      border-bottom: 1px solid var(--line);
    }

    .hero-media {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          90deg,
          var(--bg) 4%,
          color-mix(in srgb, var(--bg) 72%, transparent) 52%,
          color-mix(in srgb, var(--bg) 35%, transparent)
        ),
        linear-gradient(0deg, var(--bg) 0%, transparent 45%),
        url("https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/e073b00d-130a-5a6a-b24e-580aebd62029/325e6975-a2d1-5f5b-8584-9e34c83c688b.jpg")
        center/cover;
    }

    .hero-content {
      position: relative;
      padding-block: clamp(var(--space-20), 11vw, var(--space-32));
    }

    .hero h1 {
      font: 500 var(--text-3xl)/.95 var(--font-display);
      max-width: 13ch;
      letter-spacing: -.03em;
    }

    .hero h1 em {
      color: var(--gold);
      font-style: italic;
    }

    .hero p {
      max-width: 58ch;
      color: var(--muted);
      margin-top: var(--space-6);
    }

    .hero-actions {
      display: flex;
      gap: var(--space-4);
      flex-wrap: wrap;
      margin-top: var(--space-8);
    }

    .hero-meta {
      display: flex;
      gap: var(--space-8);
      flex-wrap: wrap;
      margin-top: var(--space-12);
      font-size: var(--text-sm);
      color: var(--muted);
    }

    .hero-meta strong {
      display: block;
      color: var(--text);
      font-size: var(--text-base);
    }

    .capability {
      border-bottom: 1px solid var(--line);
      background: var(--surface);
    }

    .capability .container {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }

    .capability-item {
      padding: var(--space-6);
      border-right: 1px solid var(--line);
    }

    .capability-item:last-child {
      border-right: 0;
    }

    .capability-item strong {
      display: block;
      font-size: var(--text-lg);
    }

    .capability-item span {
      font-size: var(--text-sm);
      color: var(--muted);
    }

    .services-grid {
      display: grid;
      grid-template-columns: 1.15fr .85fr .85fr;
      gap: var(--space-4);
    }

    .service {
      min-height: 15rem;
      background: var(--surface);
      border: 1px solid var(--line);
      padding: var(--space-6);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform var(--transition), background var(--transition);
    }

    .service:hover {
      transform: translateY(-4px);
      background: var(--surface-2);
    }

    .service.featured {
      grid-row: span 2;
      min-height: 31rem;
      background:
        linear-gradient(0deg, color-mix(in srgb, var(--bg) 80%, transparent), transparent 55%),
        url("https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/01905b5f-f6ed-5d7f-949d-8d453f494892/594dd933-586b-5f47-a120-80cec0c8f64d.jpg")
        center/cover;
    }

    .service.featured .service-top {
      background: color-mix(in srgb, var(--bg) 70%, transparent);
      padding: var(--space-4);
      margin: calc(var(--space-6) * -1);
      margin-bottom: 0;
    }

    .service-number {
      font: var(--text-sm) var(--font-body);
      color: var(--gold);
    }

    .service h3 {
      font: 700 var(--text-lg)/1.15 var(--font-body);
      margin-top: var(--space-2);
    }

    .service p {
      font-size: var(--text-sm);
      color: var(--muted);
      margin-top: var(--space-2);
    }

    .service-arrow {
      align-self: flex-end;
      color: var(--gold);
      font-size: var(--text-xl);
    }

    .products {
      background: var(--surface);
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border: 1px solid var(--line);
    }

    .product {
      padding: var(--space-6);
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      min-height: 14rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: background var(--transition);
    }

    .product:nth-child(4n) {
      border-right: 0;
    }

    .product:hover {
      background: var(--surface-2);
    }

    .product .icon {
      color: var(--gold);
      font-size: 1.7rem;
      line-height: 1;
    }

    .product h3 {
      font-size: var(--text-base);
      margin-top: var(--space-6);
    }

    .product p {
      font-size: var(--text-sm);
      color: var(--muted);
    }

    .requirements {
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: var(--space-10);
      align-items: start;
    }

    .requirement-image {
      position: sticky;
      top: 7rem;
      min-height: 34rem;
      background:
        linear-gradient(0deg, color-mix(in srgb, var(--bg) 50%, transparent), transparent),
        url("https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/620bc374-f9d2-5b4a-997d-ebb0de690af9/c3060043-1846-5e01-99c4-8c11a76580fe.jpg")
        center/cover;
    }

    .requirement-list {
      border-top: 1px solid var(--line);
    }

    .requirement {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
      padding: var(--space-6) 0;
      border-bottom: 1px solid var(--line);
    }

    .requirement h3 {
      font-size: var(--text-lg);
    }

    .requirement p {
      font-size: var(--text-sm);
      color: var(--muted);
      max-width: 44ch;
    }

    .why {
      background: var(--gold);
      color: #181207;
    }

    .why .eyebrow {
      color: #664000;
    }

    .why .section-copy {
      color: #514019;
    }

    .why-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
      margin-top: var(--space-10);
    }

    .why-grid article {
      border-top: 1px solid rgba(23, 18, 10, .24);
      padding-top: var(--space-4);
    }

    .why-grid h3 {
      font-size: var(--text-lg);
    }

    .why-grid p {
      color: #4c3a15;
      margin-top: var(--space-2);
      font-size: var(--text-sm);
    }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-4);
    }

    .step {
      border-top: 1px solid var(--line);
      padding-top: var(--space-4);
    }

    .step span {
      color: var(--gold);
      font-size: var(--text-sm);
      font-weight: 700;
    }

    .step h3 {
      font-size: var(--text-lg);
      margin-top: var(--space-4);
    }

    .step p {
      font-size: var(--text-sm);
      color: var(--muted);
      margin-top: var(--space-2);
    }

    .quote {
      padding-block: var(--space-20);
      background: var(--surface);
      border-top: 1px solid var(--line);
    }

    .quote-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-12);
      align-items: end;
    }

    .quote h2 {
      font: 500 var(--text-2xl)/1.08 var(--font-display);
    }

    .quote p {
      color: var(--muted);
      margin-top: var(--space-4);
    }

    .quote-actions {
      display: flex;
      gap: var(--space-4);
      justify-content: flex-end;
      flex-wrap: wrap;
    }

    .footer {
      border-top: 1px solid var(--line);
      padding-block: var(--space-12);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr .8fr 1fr;
      gap: var(--space-10);
    }

    .footer h3 {
      font-size: var(--text-sm);
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--gold);
      margin-bottom: var(--space-4);
    }

    .footer p,
    .footer a {
      font-size: var(--text-sm);
      color: var(--muted);
    }

    .footer a:hover {
      color: var(--gold);
    }

    .footer-links {
      display: grid;
      gap: var(--space-2);
    }

    .footer-bottom {
      margin-top: var(--space-10);
      padding-top: var(--space-4);
      border-top: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      gap: var(--space-4);
      color: var(--faint);
      font-size: var(--text-xs);
    }

    @media (max-width: 860px) {
      .nav-links {
        display: none;
      }

      .menu {
        display: block;
      }

      .menu-open .nav-links {
        display: flex;
        position: absolute;
        top: 5rem;
        left: 0;
        right: 0;
        background: var(--surface);
        border-bottom: 1px solid var(--line);
        padding: var(--space-6);
        flex-direction: column;
        align-items: stretch;
      }

      .capability .container {
        grid-template-columns: repeat(2, 1fr);
      }

      .capability-item:nth-child(2) {
        border-right: 0;
      }

      .capability-item:nth-child(-n+2) {
        border-bottom: 1px solid var(--line);
      }

      .services-grid {
        grid-template-columns: 1fr 1fr;
      }

      .service.featured {
        grid-row: span 1;
        grid-column: span 2;
        min-height: 22rem;
      }

      .product-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .product:nth-child(2n) {
        border-right: 0;
      }

      .requirements {
        grid-template-columns: 1fr;
      }

      .requirement-image {
        position: relative;
        top: auto;
        min-height: 18rem;
      }

      .process-grid {
        grid-template-columns: 1fr 1fr;
      }

      .quote-inner,
      .footer-grid {
        grid-template-columns: 1fr;
      }

      .quote-actions {
        justify-content: flex-start;
      }
    }

    @media (max-width: 560px) {
      .topbar .container {
        padding-block: var(--space-2);
        align-items: flex-start;
        flex-direction: column;
      }

      .nav-actions .btn {
        display: none;
      }

      .hero {
        min-height: 44rem;
      }

      .hero h1 {
        font-size: clamp(2.7rem, 12vw, 4.2rem);
      }

      .hero-meta {
        gap: var(--space-5);
      }

      .services-grid {
        grid-template-columns: 1fr;
      }

      .service.featured {
        grid-column: auto;
      }

      .product-grid {
        grid-template-columns: 1fr;
      }

      .product {
        border-right: 0;
      }

      .why-grid,
      .process-grid {
        grid-template-columns: 1fr;
      }

      .footer-bottom {
        flex-direction: column;
      }

      .requirement {
        align-items: flex-start;
        flex-direction: column;
        gap: var(--space-2);
      }
    }
  </style>
</head>

